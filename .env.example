# Contact form delivery (server-only; never prefix these with NEXT_PUBLIC_).
# Needed at build time too: /contact is prerendered with the form enabled or disabled.
# 1. Create an API key at https://resend.com
# 2. Verify your sending domain in Resend
RESEND_API_KEY=
# The verified business inbox that receives inquiries
CONTACT_TO_EMAIL=
# Sender on the verified domain, e.g. Nexus Morrow <hello@nexusmorrow.com>
CONTACT_FROM_EMAIL=

# Analytics (optional, build time). Unset = no analytics script and no events.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nexusmorrow.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Show pending/draft content (case study slots, draft insights, privacy draft) on a preview deployment
# NEXT_PUBLIC_SHOW_PENDING=true
